# Copy to .env.local for local dev. Without the Supabase vars the app runs on an in-memory store.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Server only — Supabase "secret" key (sb_secret_…) or legacy service_role key. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Not used by v1 (all data goes through the server); kept for later client features.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 4-digit PIN the kitchen tablet asks for. Required in production.
STAFF_PIN=
# Leave unset for real UPI to the shop's UPI ID (lib/shop.ts); staff confirm on the soundbox.
# PAYMENTS=mock shows a fake payee and a "Simulate payment" button (tests, demos).
PAYMENTS=
