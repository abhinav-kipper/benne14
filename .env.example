# Copy to .env.local for local dev. Without the Supabase vars the app runs on an in-memory store.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Server only — Supabase "secret" key (sb_secret_…) or legacy service_role key. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# 4-digit PIN for the kitchen screen and for setting a tablet up as the kiosk. Required in production.
STAFF_PIN=
# 6-digit PIN for the owner app. Until it is set the owner app opens with the staff PIN.
OWNER_PIN=
# PAYMENTS=easebuzz (production): UPI confirmed by the gateway; needs the two Easebuzz values below.
# PAYMENTS=mock: a fake payee and a "Simulate payment" button (tests, demos).
# Unset: the shop's own UPI QR (lib/shop.ts), confirmed by staff at the counter.
PAYMENTS=
EASEBUZZ_KEY=
EASEBUZZ_SALT=

# Test mode is ON unless TEST_MODE=0: cash counts as paid (straight to the kitchen) and a ₹1
# "Payment test" item appears. Set TEST_MODE=0 in Vercel before real customers.
TEST_MODE=
